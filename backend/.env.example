# =============================================================================
# SocialApp Backend Environment Variables Template
# Copy this file to .env or export these variables in your shell environment.
# =============================================================================

# Server Port & Active Profile
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MariaDB / MySQL Configuration
DB_URL=jdbc:mysql://localhost:3306/socialapp?useSSL=false&serverTimezone=UTC&characterEncoding=utf8&createDatabaseIfNotExist=true
DB_USER=socialapp
DB_PASS=socialapp

# JWT Security Configuration (Min 32 characters for HS256)
JWT_SECRET=c29jaWFsYXBwLXNlY3JldC1rZXktZm9yLWp3dC1hdXRoZW50aWNhdGlvbi0yNTYtYml0cyE=
JWT_EXPIRY_HOURS=168

# Application Base URL (for share links: {APP_BASE_URL}/m/{id})
APP_BASE_URL=http://localhost:8080

# Storage Mode: 'local' (disk fallback) or 'r2' (Cloudflare R2)
STORAGE_MODE=local
LOCAL_STORAGE_DIR=./media-storage

# Cloudflare R2 / AWS S3 Compatible Credentials
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=socialapp
R2_PUBLIC_BASE_URL=https://pub-r2.dev

# Media & Thumbnail Processing
FFMPEG_PATH=/usr/sbin/ffmpeg
PLACEHOLDER_THUMB_URL=http://localhost:8080/placeholder-thumb.jpg
